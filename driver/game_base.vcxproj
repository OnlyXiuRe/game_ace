<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7C2E9A11-4B6F-4C8D-9A3E-1D5F2B6C8A11}</ProjectGuid>
    <RootNamespace>game_base</RootNamespace>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- ==================== Debug ==================== -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
  </PropertyGroup>

  <!-- ==================== Release ==================== -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>game_base</TargetName>
    <SignMode>Off</SignMode>
  </PropertyGroup>

  <!-- Debug: 瀹氫箟 DBG, 鏃ュ織瀹忕敓鏁?-->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <TreatWarningAsError>false</TreatWarningAsError>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <SpectreMitigation>false</SpectreMitigation>
      <PreprocessorDefinitions>DBG;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)utils\log;$(ProjectDir)utils\hook;$(ProjectDir)core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <DriverSign>
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <!-- Release: 涓嶅畾涔?DBG, 鏃ュ織瀹忓叏閮ㄥ睍寮€涓虹┖ -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <TreatWarningAsError>false</TreatWarningAsError>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <SpectreMitigation>false</SpectreMitigation>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)utils\log;$(ProjectDir)utils\hook;$(ProjectDir)core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <DriverSign>
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver_main.c" />
    <ClCompile Include="utils\log\game_log.c" />
    <ClCompile Include="core\driver_lookup.c" />
    <ClCompile Include="utils\hook\hook.c" />
    <ClCompile Include="utils\hook\hook_dispatch.c" />
    <ClCompile Include="utils\hook\hook_inline.c" />
    <ClCompile Include="core\ioctl.c" />
    <ClCompile Include="core\driver_scan.c" />
    <ClCompile Include="core\usb_audit.c" />
    <ClCompile Include="core\usb_node.c" />
    <ClCompile Include="core\usb_hub.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\log_types.h" />
    <ClInclude Include="include\game_base.h" />
    <ClInclude Include="utils\log\game_log.h" />
    <ClInclude Include="include\module.h" />
    <ClInclude Include="include\symbol.h" />
    <ClInclude Include="utils\hook\hook.h" />
    <ClInclude Include="core\modules.h" />
    <ClInclude Include="core\usb_node.h" />
    <ClInclude Include="core\usb_hub.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
